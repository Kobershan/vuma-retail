                    </div>

                    <div class="vuma-step">
                        <div class="vuma-step-circle">3</div>
                        <div class="vuma-step-label">Locations</div>
                    </div>

                    <div class="vuma-step">
                        <div class="vuma-step-circle">4</div>
                        <div class="vuma-step-label">Mapping</div>
                    </div>

                    <div class="vuma-step">
                        <div class="vuma-step-circle">5</div>
                        <div class="vuma-step-label">Modules</div>
                    </div>

                    <div class="vuma-step">
                        <div class="vuma-step-circle">6</div>
                        <div class="vuma-step-label">Limits</div>
                    </div>

                    <div class="vuma-step">
                        <div class="vuma-step-circle">7</div>
