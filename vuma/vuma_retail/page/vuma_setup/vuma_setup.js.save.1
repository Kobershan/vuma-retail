                color: var(--text-muted, #64748b);
            }

            .vuma-step.active .vuma-step-circle {
                background: #111827;
                border-color: #111827;
                color: #fff;
            }

            .vuma-step-label {
                font-size: 11px;
                color: var(--text-muted, #64748b);
                white-space: nowrap;
            }

            .vuma-step.active .vuma-step-label {
                color: var(--text-color, #111827);
                font-weight: 700;
            }

            .vuma-content-card {
                background: var(--card-bg, #fff);
                border: 1px solid var(--border-color, #e5e7eb);
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 10px 35px rgba(15, 23, 42, .06);
            }

            .vuma-content-header {
                padding: 28px 30px 22px;
                border-bottom: 1px solid var(--border-color, #e5e7eb);
            }

            .vuma-eyebrow {
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .08em;
                color: #64748b;
                margin-bottom: 8px;
            }

            .vuma-content-header h2 {
                margin: 0;
                font-size: 24px;
                font-weight: 740;
                color: var(--text-color, #111827);
            }

            .vuma-content-header p {
                margin: 8px 0 0;
                color: var(--text-muted, #64748b);
                font-size: 14px;
                line-height: 1.6;
                max-width: 700px;
            }

            .vuma-content-body {
                padding: 30px;
            }

            .vuma-info-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 16px;
            }

            .vuma-info-box {
                border: 1px solid var(--border-color, #e5e7eb);
                border-radius: 16px;
                padding: 20px;
                background: var(--subtle-fg, #f8fafc);
            }

            .vuma-info-icon {
                width: 38px;
                height: 38px;
                border-radius: 11px;
                background: #111827;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                margin-bottom: 15px;
            }

            .vuma-info-box strong {
                display: block;
                font-size: 14px;
                margin-bottom: 5px;
                color: var(--text-color, #111827);
            }

            .vuma-info-box span {
                display: block;
                color: var(--text-muted, #64748b);
                font-size: 12px;
                line-height: 1.55;
            }

            .vuma-footer {
                padding: 22px 30px;
                border-top: 1px solid var(--border-color, #e5e7eb);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
            }

            .vuma-footer-note {
                font-size: 12px;
                color: var(--text-muted, #64748b);
            }

            .vuma-primary-btn {
                appearance: none;
                border: 0;
                border-radius: 11px;
                background: #111827;
                color: white;
                padding: 11px 20px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: .18s ease;
            }

            .vuma-primary-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 22px rgba(15, 23, 42, .18);
            }

            @media (max-width: 850px) {
                .vuma-info-grid {
                    grid-template-columns: 1fr;
                }

                .vuma-step-label {
                    display: none;
                }

                .vuma-hero h1 {
                    font-size: 28px;
                }
            }
        </style>

        <div class="vuma-setup-shell">

            <div class="vuma-hero">
                <div class="vuma-brand-row">
                    <div class="vuma-brand">
                        <div class="vuma-logo">V</div>
                        <div>
                            <div class="vuma-brand-title">Vuma Retail</div>
                            <div class="vuma-brand-subtitle">Business platform configuration</div>
                        </div>
                    </div>
                </div>

                <h1>Set up your Vuma installation</h1>

                <p>
                    Configure your business structure, operating locations,
