                    </button>
                </div>

            </div>

        </div>
    `).appendTo(page.body);

   $("#vuma-start-setup").on("click", function () {
    $(".vuma-content-card").html(`
        <div class="vuma-content-header">
            <div class="vuma-eyebrow">Step 1 of 7</div>
            <h2>Installation Details</h2>
            <p>
                Enter the basic details for this Vuma installation.
            </p>
        </div>

        <div class="vuma-content-body">
            <div id="vuma-installation-form"></div>
        </div>

        <div class="vuma-footer">
            <button class="btn btn-default" id="vuma-back-welcome">
                ← Back
            </button>

            <button class="vuma-primary-btn" id="vuma-save-installation">
                Save & Continue →
            </button>
        </div>
    `);

    const fields = [
        {
            fieldtype: "Data",
            fieldname: "installation_name",
            label: "Installation Name",
            reqd: 1
        },
        {
            fieldtype: "Data",
            fieldname: "customer_name",
            label: "Customer Name",
            reqd: 1
        },
        {
            fieldtype: "Int",
            fieldname: "company_count",
            label: "Number of Companies",
            default: 1,
            reqd: 1
        },
        {
            fieldtype: "Int",
            fieldname: "location_count",
            label: "Number of Locations",
            default: 1,
            reqd: 1
        },
        {
            fieldtype: "Int",
            fieldname: "licensed_user_count",
            label: "Licensed User Count",
            default: 1,
            reqd: 1
        },
        {
            fieldtype: "Int",
            fieldname: "licensed_pos_count",
            label: "Licensed POS Count",
            default: 0
        }
    ];

    const field_group = new frappe.ui.FieldGroup({
        fields: fields,
        body: $("#vuma-installation-form")[0]
    });

    field_group.make();

    $("#vuma-save-installation").on("click", async function () {
    const values = field_group.get_values();

    if (!values) {
        return;
    }

    if (
        values.company_count < 1 ||
        values.location_count < 1 ||
        values.licensed_user_count < 1 ||
        values.licensed_pos_count < 0
    ) {
        frappe.msgprint(__("Please enter valid installation limits."));
        return;
    }

    const button = $(this);
    button.prop("disabled", true).text("Saving...");

    try {
        const doc = await frappe.db.insert({
            doctype: "Vuma Installation",

            installation_name: values.installation_name,
            customer_name: values.customer_name,

            company_count: values.company_count,
            location_count: values.location_count,

            licensed_user_count: values.licensed_user_count,
            licensed_pos_count: values.licensed_pos_count,

            setup_complete: 0,
            licence_status: "Pending",
            integrity_status: "Unknown"
        });

        frappe.show_alert({
            message: __("Installation created successfully."),
            indicator: "green"
        });

        console.log("Created Vuma Installation:", doc);

        show_company_step(doc);
    } catch (error) {
        console.error(error);

        frappe.msgprint({
            title: __("Unable to create installation"),
            message: error.message || __("An error occurred while saving."),
            indicator: "red"
        });

        button.prop("disabled", false).text("Save & Continue →");
    }
});

    $("#vuma-back-welcome").on("click", function () {
        window.location.reload();
    });
});
};
