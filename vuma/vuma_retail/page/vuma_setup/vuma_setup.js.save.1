            .vuma-stepper {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 10px;
                position: relative;
            }

            .vuma-stepper::before {
                content: "";
                position: absolute;
                top: 17px;
                left: 5%;
                right: 5%;
                height: 2px;
                background: var(--border-color, #e5e7eb);
                z-index: 0;
            }

            .vuma-step {
                position: relative;
                z-index: 1;
                text-align: center;
                flex: 1;
                min-width: 90px;
            }

            .vuma-step-circle {
                width: 34px;
                height: 34px;
